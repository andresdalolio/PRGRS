# Public browser configuration; also used by the server to validate user JWTs.
# Never put a service-role key, sb_secret_ key, database password or access token here.
# NEXT_PUBLIC values are embedded during build; rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
